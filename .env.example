# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# Server-only Resend API credentials for automated password management and transactional emails
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
RESEND_FROM_EMAIL=Premier Lighting <no-reply@premierlighting.site>
RESEND_ACCOUNT_OWNER=
RESEND_TEST_EMAIL=

# Admin Registration Access Code
VITE_ADMIN_REGISTRATION_CODE=

# Password hashing pepper. Keep this stable to preserve existing password hashes.
VITE_HASH_PEPPER=

# Firebase Client Configuration (Configured from project settings)
VITE_APP_URL=https://premierlighting.site
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
